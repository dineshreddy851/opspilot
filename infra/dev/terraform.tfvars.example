# Copy this file to terraform.tfvars only when you are ready to test Bedrock.
# Terraform applies the exact configured model ID to the Lambda environment and
# grants only bedrock:InvokeModel for that foundation model ARN.
bedrock_enabled  = true
bedrock_model_id = "amazon.nova-lite-v1:0"

# Checkpoint 7 publishes approval notifications to this optional email
# subscription. AWS sends a confirmation email before notifications begin.
approval_email = "you@example.com"

# Keep the controlled action in dry-run mode until the approval workflow has
# been reviewed and tested end to end.
controlled_action_dry_run = true

# Optional company-ready operations settings.
operations_alert_email   = "you@example.com"
log_retention_days       = 14
cloudtrail_retention_days = 90
